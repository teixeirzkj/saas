# ----- Banco de dados (Supabase Postgres) -----
# Pegue as duas em: Supabase -> botao "Connect" -> aba ORMs -> Prisma
# DATABASE_URL = pooler modo transaction (porta 6543) - usada em runtime
# DIRECT_URL   = conexao direta (porta 5432) - usada so por `prisma db push`/migrate
DATABASE_URL="postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ----- Sessao / Auth -----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"

# ----- App -----
# Em producao, a URL publica do seu deploy (ex.: https://seu-projeto.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Upload de imagens -----
# Preenchido automaticamente pela Vercel quando voce ativa Storage -> Blob no
# dashboard do projeto. Sem essa variavel, o upload cai para disco local
# (so funciona em dev, nao em produção na Vercel).
BLOB_READ_WRITE_TOKEN=""

# ----- IA (Nexo IA) -----
# Sem a chave o modulo usa o gerador local de templates (fallback funcional).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ----- Pagamentos (InfinitePay ou outro gateway) -----
PAYMENT_PROVIDER="mock"           # mock | infinitepay
INFINITEPAY_HANDLE=""             # ex: $seunegocio
INFINITEPAY_API_KEY=""
PAYMENT_WEBHOOK_SECRET="troque-este-webhook-secret"
