# ----- Banco de dados -----
# Dev (SQLite). Para producao troque o provider em prisma/schema.prisma para "postgresql"
DATABASE_URL="file:./dev.db"

# ----- Sessao / Auth -----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- IA (Nexo IA) -----
# Sem a chave o modulo usa o gerador local de templates (fallback funcional).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ----- Pagamentos (InfinitePay ou outro gateway) -----
PAYMENT_PROVIDER="mock"           # mock | infinitepay
INFINITEPAY_HANDLE=""             # ex: $seunegocio
INFINITEPAY_API_KEY=""
PAYMENT_WEBHOOK_SECRET="troque-este-webhook-secret"
